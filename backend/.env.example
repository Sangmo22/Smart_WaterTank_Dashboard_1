PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/smart-water-tank
JWT_SECRET=your_jwt_secret_key_change_me_in_production
CORS_ORIGIN=*
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Water Tank Alerts <alerts@your-verified-domain.com>
ALERT_EMAIL=you@example.com

# ThingSpeak pump command forwarding
THINGSPEAK_WRITE_KEY=your_thingspeak_channel_write_api_key
# ThingSpeak channel field where the pump ON/OFF command is published
THINGSPEAK_PUMP_FIELD=5
