# Backend API base URL. REQUIRED for production web deploys where the API
# is hosted separately from the static frontend (e.g. https://your-app.onrender.com).
# Leave unset for local dev - it auto-detects http://<host>:5000.
# Set this in Vercel > Settings > Environment Variables and redeploy.
EXPO_PUBLIC_API_URL=

EXPO_PUSH_TOKEN=ExponentPushToken[put-your-phone-token-here]

THINGSPEAK_CHANNEL_ID=3420273
THINGSPEAK_READ_API_KEY=WZV2KJC22K3ZDNGM
SOURCE_FIELD=1
SOURCE_MIN_RAW=0
SOURCE_MAX_RAW=100
SOURCE_INVERT=false

SOURCE_ALERT_THRESHOLD=8
POLL_INTERVAL_MS=15000
ALERT_REMINDER_MS=1800000
