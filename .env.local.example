EXPO_PUSH_TOKEN=ExponentPushToken[put-your-phone-token-here]

# Email alerts are delivered by Resend. This key never belongs in EXPO_PUBLIC_*
# variables or in frontend source code.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Water Tank Alerts <alerts@your-verified-domain.com>
ALERT_EMAIL=you@example.com

THINGSPEAK_CHANNEL_ID=3420273
THINGSPEAK_READ_API_KEY=WZV2KJC22K3ZDNGM
SOURCE_FIELD=1
SOURCE_MIN_RAW=0
SOURCE_MAX_RAW=100
SOURCE_INVERT=false

SOURCE_ALERT_THRESHOLD=8
POLL_INTERVAL_MS=15000
ALERT_REMINDER_MS=1800000
